{
  "name": "urscript",
  "displayName": "URScript",
  "description": "URScript language support powered by urscript-ls",
  "version": "0.1.0",
  "publisher": "thor",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "activationEvents": [
    "onLanguage:urscript"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "urscript",
        "aliases": ["URScript", "urscript"],
        "extensions": [".script", ".urscript", ".variables"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "urscript",
        "scopeName": "source.urscript",
        "path": "./syntaxes/urscript.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "urscript",
        "path": "./snippets/urscript.json"
      }
    ],
    "configuration": {
      "title": "URScript",
      "properties": {
        "urscript.server.path": {
          "type": "string",
          "default": "urscript-ls",
          "description": "Path to the urscript-ls language server binary."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.75.0",
    "typescript": "^5.3.0"
  }
}
