{
  "name": "urscript-ls",
  "displayName": "URScript Language Server",
  "description": "URScript language support with full LSP features",
  "version": "0.2.0",
  "publisher": "ts91",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/ts91/urscript-ls"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "urscript",
    "universal robots",
    "robotics",
    "ur",
    "cobot"
  ],
  "galleryBanner": {
    "color": "#56a2d6",
    "theme": "dark"
  },
  "activationEvents": [
    "onLanguage:urscript"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "urscript",
        "aliases": [
          "URScript",
          "urscript"
        ],
        "extensions": [
          ".script",
          ".urscript",
          ".variables"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "urscript",
        "scopeName": "source.urscript",
        "path": "./syntaxes/urscript.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "urscript",
        "path": "./snippets/urscript.json"
      }
    ],
    "configuration": {
      "title": "URScript",
      "properties": {
        "urscript.server.path": {
          "type": "string",
          "default": "urscript-ls",
          "description": "Path to the urscript-ls language server binary."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && node esbuild.js",
    "check-types": "tsc --noEmit",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && node esbuild.js --production"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/vscode": "^1.75.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.28.2",
    "npm-run-all2": "^8.0.4",
    "ovsx": "^0.9.0",
    "typescript": "^5.3.0"
  }
}
